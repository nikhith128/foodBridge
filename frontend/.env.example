# Frontend environment variables.
#
# You normally do NOT need to create a .env file: vite.config.js already proxies
# /api to http://localhost:5000, so the default below is what development uses.
#
# Copy this file to .env only if you want to point the client somewhere else,
# for example a deployed API:
#
#   Copy-Item .env.example .env
#
# Never commit .env — it is listed in .gitignore.

# Base URL for the API. Default: /api (through the Vite dev proxy).
VITE_API_URL=/api
