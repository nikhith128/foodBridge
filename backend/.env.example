# FoodBridge AI — backend environment template
# Copy to .env and fill in real values. Never commit .env.

PORT=5000

# Hosted MySQL in production, e.g.
# mysql://USER:PASSWORD@HOST:3306/foodbridge
DATABASE_URL="mysql://root:password@localhost:3306/foodbridge"

# At least 16 characters. Generate a fresh one for production; do not reuse
# the local development secret.
JWT_SECRET="replace-with-a-long-random-string"

# The exact frontend origin allowed by CORS (no trailing slash).
# Local: http://localhost:5173   Production: https://your-frontend-domain
CLIENT_URL="http://localhost:5173"
