# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.

# Port the Express server listens on
PORT=5000

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:YOUR_MYSQL_ROOT_PASSWORD@localhost:3306/foodbridge"

# Long random string used to sign JWTs. Generate your own, do not reuse this one.
JWT_SECRET="replace-this-with-a-long-random-secret-string"

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
